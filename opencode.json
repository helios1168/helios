{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git merge*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git push*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git worktree*": "deny",
      "git tag*": "deny",
      "git branch -D*": "deny",
      "bd close*": "deny",
      "bd update*": "deny",
      "bd create*": "deny",
      "bd delete*": "deny",
      "bd remember*": "deny",
      "bd forget*": "deny",
      "bd dolt*": "deny"
    }
  }
}
